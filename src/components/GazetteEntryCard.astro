---
import { formatDate, isoDate } from "../lib/format";
import type { NumberedEntry } from "../lib/gazette";

interface Props extends NumberedEntry {
  /** Heading level of the title: 2 on the Gazette page, 3 on the home page. */
  headingLevel?: 2 | 3;
}

const { entry, no, headingLevel = 2 } = Astro.props;
const { title, date, summary, pinned } = entry.data;
const Heading = headingLevel === 3 ? "h3" : "h2";

// The title link is stretched over the whole card (after:absolute after:inset-0), so the
// card is clickable while the link's accessible name stays just the title. The card shows
// the focus ring when the link is focused.
---

<article class="relative h-full rounded-card border border-line bg-surface p-6 shadow-card hover:border-amethyst-500/60 hover:shadow-glow has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-3 has-[a:focus-visible]:outline-accent-soft motion-safe:transition">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
    <span class="font-semibold text-accent-soft">No. {no}</span>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    {pinned && (
      <span class="rounded-full border border-amethyst-500/60 px-2 py-0.5 text-xs font-semibold text-accent-soft">
        Pinned
      </span>
    )}
  </p>
  <Heading class="mt-2 text-xl font-bold text-ink">
    <a
      href={`/gazette/${entry.id}/`}
      class="after:absolute after:inset-0 focus-visible:outline-hidden"
    >
      {title}
    </a>
  </Heading>
  <p class="mt-2 text-muted">{summary}</p>
</article>
