---
/** A card that links to one of the site's sections. The whole card is the link. */
interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<a
  href={href}
  class="group block h-full rounded-card border border-line bg-surface p-6 shadow-card hover:border-amethyst-500/60 hover:shadow-glow motion-safe:transition motion-safe:hover:-translate-y-0.5"
>
  <h3 class="flex items-center justify-between gap-4 text-xl font-bold text-ink">
    {title}
    <span
      aria-hidden="true"
      class="text-accent motion-safe:transition-transform motion-safe:group-hover:translate-x-1"
    >
      →
    </span>
  </h3>
  <p class="mt-2 text-muted">{description}</p>
</a>
