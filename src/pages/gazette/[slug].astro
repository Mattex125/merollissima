---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { formatDate, isoDate } from "../../lib/format";
import { getGazette } from "../../lib/gazette";

export const getStaticPaths = (async () => {
  const entries = await getGazette(); // newest first
  return entries.map((item, index) => ({
    params: { slug: item.entry.id },
    props: {
      ...item,
      newer: index > 0 ? entries[index - 1] : undefined,
      older: entries[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, no, newer, older } = Astro.props;
const { title, date, summary, cover, coverAlt } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <Container>
    <article class="mx-auto max-w-2xl pt-12 sm:pt-16">
      <a
        href="/gazette/"
        class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent-soft underline hover:decoration-2"
      >
        <span aria-hidden="true">←</span>
        Gazette
      </a>

      <header class="mt-6">
        <p class="flex flex-wrap items-center gap-x-2 text-sm text-muted">
          <span class="font-semibold text-accent-soft">No. {no}</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
        </p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{title}</h1>
        <p class="mt-4 text-lg text-muted">{summary}</p>
      </header>

      {cover && coverAlt && (
        <Image
          src={cover}
          alt={coverAlt}
          width={672}
          loading="eager"
          class="mt-10 w-full rounded-card border border-line"
        />
      )}

      <div class="prose mt-10 max-w-none prose-amethyst prose-headings:font-display prose-a:underline-offset-4 prose-img:rounded-card">
        <Content />
      </div>
    </article>

    {(older || newer) && (
      <nav
        aria-label="More from the Gazette"
        class="mx-auto mt-16 grid max-w-2xl gap-4 border-t border-line pt-8 sm:grid-cols-2"
      >
        {older && (
          <a
            href={`/gazette/${older.entry.id}/`}
            class="rounded-card border border-line p-4 hover:border-amethyst-500/60 hover:bg-surface motion-safe:transition-colors"
          >
            <span class="block text-sm text-muted">Previous · No. {older.no}</span>
            <span class="mt-1 block font-semibold text-ink">{older.entry.data.title}</span>
          </a>
        )}
        {newer && (
          <a
            href={`/gazette/${newer.entry.id}/`}
            class="rounded-card border border-line p-4 hover:border-amethyst-500/60 hover:bg-surface motion-safe:transition-colors sm:col-start-2 sm:text-right"
          >
            <span class="block text-sm text-muted">Next · No. {newer.no}</span>
            <span class="mt-1 block font-semibold text-ink">{newer.entry.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </Container>
</BaseLayout>
