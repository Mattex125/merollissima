---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuroraBackground from "../../components/AuroraBackground.astro";
import PostcardsBackground from "../../components/PostcardsBackground.astro";
import Container from "../../components/Container.astro";
import GazetteEntryCard from "../../components/GazetteEntryCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SECTIONS } from "../../config/site";
import { getGalleryPhotos } from "../../lib/gallery";
import { getGazette } from "../../lib/gazette";

const { label, description } = SECTIONS.gazette;
const galleryPhotos = await getGalleryPhotos();
const entries = await getGazette();
---

<BaseLayout title={label} description={description}>
  <AuroraBackground />
  {galleryPhotos.length > 0 && <PostcardsBackground photos={galleryPhotos} />}
  <Container>
    <PageHeader title={label} lead={description} />
    {entries.length > 0 ? (
      <ol class="grid max-w-3xl gap-4">
        {entries.map((item) => (
          <li>
            <GazetteEntryCard {...item} />
          </li>
        ))}
      </ol>
    ) : (
      <p class="text-muted">No entries yet.</p>
    )}
  </Container>
</BaseLayout>
