---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChapterPhoto from "../../components/ChapterPhoto.astro";
import Container from "../../components/Container.astro";
import LorePlaceholder from "../../components/LorePlaceholder.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SECTIONS } from "../../config/site";
import { getChapters } from "../../lib/history";

const { label, description } = SECTIONS.history;

// The whole history is one page: every chapter is rendered here, in order.
const chapters = await Promise.all(
  (await getChapters()).map(async (chapter) => ({ chapter, ...(await render(chapter)) })),
);

// Every anchor on the page must be unique: the chapters, the headings inside
// them (ids are generated per chapter, so they can collide) and the page's own ids.
const anchors = new Set(["main", "chapters-title"]);
for (const { chapter, headings } of chapters) {
  for (const id of [chapter.id, ...headings.map((heading) => heading.slug)]) {
    if (anchors.has(id)) {
      throw new Error(`Duplicate anchor "#${id}" on the History page (chapter "${chapter.id}").`);
    }
    anchors.add(id);
  }
}
---

<BaseLayout title={label} description={description}>
  <Container>
    <PageHeader title={label} lead={description} />
    {chapters.length > 0 ? (
      <div class="grid gap-10 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-12 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
        <nav aria-labelledby="chapters-title" class="-mx-3 md:sticky md:top-20 md:self-start">
          <p
            id="chapters-title"
            class="px-3 text-sm font-semibold tracking-wide text-muted uppercase"
          >
            Chapters
          </p>
          <ol class="mt-3 space-y-1">
            {chapters.map(({ chapter }, index) => (
              <li>
                <a
                  href={`#${chapter.id}`}
                  class="group flex gap-2 rounded-control px-3 py-1.5 text-ink hover:bg-amethyst-500/15 hover:text-accent-soft focus-visible:bg-amethyst-500/15 focus-visible:text-accent-soft motion-safe:transition-colors"
                >
                  <span class="text-muted tabular-nums group-hover:text-accent-soft group-focus-visible:text-accent-soft">
                    {index + 1}.
                  </span>
                  {chapter.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="min-w-0">
          {chapters.map(({ chapter, Content }) => (
            <section aria-labelledby={chapter.id} class="mb-16 last:mb-0">
              <h2 id={chapter.id} class="text-3xl font-bold">
                {chapter.data.title}
              </h2>
              <div class="prose mt-6 prose-amethyst">
                <Content />
              </div>
              <ChapterPhoto
                chapter={chapter.data.title}
                photo={chapter.data.photo}
                alt={chapter.data.photoAlt}
                caption={chapter.data.photoCaption}
              />
            </section>
          ))}
        </div>
      </div>
    ) : (
      <LorePlaceholder what="History chapters will be published here." />
    )}
  </Container>
</BaseLayout>
